# Copy to a local file (not committed) or export as shell env before running deploy-api.ps1
# Example:  Get-Content .env.coolify.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2].Trim('"') } }

COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
# Optional overrides:
# COOLIFY_PROJECT_UUID=
# COOLIFY_SERVER_UUID=

# Passed as script parameters (not required as env, but useful for your notes):
# SERVER_PUBLIC_IP=x.x.x.x
# WEB_DOMAIN=https://meeting.example.ac.th:3000
# LIVEKIT_DOMAIN=https://livekit.example.ac.th:7880
# ORG_ADMIN_EMAILS=admin@org.ac.th
