# Copy to .env.local. Never commit real secrets.
# Values below match the local Compose stack (infra/docker-compose.yml).
# Local-dev only — including the official LiveKit --dev key pair.

DATABASE_URL=postgresql://sru:sru_local_dev@localhost:5433/sru_conf

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=sru_livekit_local_dev_secret_do_not_use

AUTH_SECRET=
AUTH_URL=http://localhost:3000

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sru_minio
S3_SECRET_KEY=sru_minio_local_dev
S3_BUCKET=sru-chat
S3_RECORDINGS_BUCKET=sru-chat
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

ORG_ADMIN_EMAILS=
INTERNAL_CRON_SECRET=

# Comma-separated parent page origins allowed to postMessage a minted token
# into /embed/rooms/[id]. Example: https://campus.example.com,http://localhost:5173
# Local embed checkpoint: http://localhost:3000
EMBED_ALLOWED_ORIGINS=

AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=
SSO_ROLE_MAP=IT-Admin:org_admin,Hosts:host,Everyone:participant
# SCIM group → orgRole map for /scim/v2/Groups (mirrors SSO_ROLE_MAP; single-org flat list)
SCIM_GROUP_ROLE_MAP=IT-Admin:org_admin,Hosts:host,Everyone:participant

SAML_ENTRYPOINT=
SAML_ISSUER=sru-meeting
SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/acs
SAML_IDP_CERT=

LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={{username}})
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=cn
LDAP_GROUP_ATTR=memberOf
