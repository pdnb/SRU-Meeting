// Prisma 6 schema for Compose Postgres.
// Sources:
// https://www.prisma.io/docs/orm/v6/prisma-schema/overview
// https://www.prisma.io/docs/orm/v6/prisma-schema/data-model/models
// https://www.prisma.io/docs/orm/v6/prisma-schema/data-model/relations
// https://www.prisma.io/docs/orm/v6/prisma-schema/data-model/relations/self-relations
// https://www.prisma.io/docs/orm/v6/prisma-schema/data-model/relations/referential-actions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  host
  cohost
  participant
}

enum LobbyStatus {
  pending
  admitted
  denied
}

enum OrgRole {
  org_admin
  host
  participant
}

enum RecordingMode {
  composite
  tracks
}

enum RecordingStatus {
  pending_consent
  starting
  active
  finishing
  finished
  failed
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

enum BreakoutAssignmentMode {
  auto
  manual
  self_pick
}

enum BreakoutSessionStatus {
  open
  closed
}

enum PollStatus {
  open
  closed
}

enum QuestionStatus {
  pending
  answered
  dismissed
}

enum WhiteboardSessionStatus {
  open
  closed
}

enum TranscriptStatus {
  pending
  processing
  finished
  failed
}

enum MeetingSummaryStatus {
  not_configured
  pending
  finished
  failed
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String?
  passwordHash     String?
  isGuest          Boolean             @default(false)
  orgRole          OrgRole             @default(host)
  ssoProvider      String?
  ssoSubject       String?
  ldapDn           String?
  externalId       String?             @unique
  scimGroups       String[]            @default([])
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  ownedRooms       Room[]
  participations   RoomParticipant[]
  sentMessages     ChatMessage[]       @relation("ChatSent")
  receivedMessages ChatMessage[]       @relation("ChatReceived")
  recordings       Recording[]
  consents         RecordingConsent[]
  streams          Stream[]
  streamConsents   StreamConsent[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]          @relation("AuditActor")
  breakoutAssignments BreakoutAssignment[]
  pollsCreated        Poll[]
  pollVotes           PollVote[]
  questions           Question[]
  questionUpvotes     QuestionUpvote[]
  whiteboardsOpened   WhiteboardSession[]
  qosReports          QosReport[]

  @@unique([ssoProvider, ssoSubject])
}

model Room {
  id                  String            @id @default(cuid())
  name                String
  createdAt           DateTime          @default(now())
  ownerId             String
  owner               User              @relation(fields: [ownerId], references: [id])
  passwordHash        String?
  lobbyEnabled        Boolean           @default(false)
  locked              Boolean           @default(false)
  finishedAt          DateTime?
  allowGuests         Boolean           @default(false)
  signedInOnly        Boolean           @default(true)
  allowedEmailDomains String[]          @default([])
  allowScreenShare    Boolean           @default(true)
  allowChat           Boolean           @default(true)
  maxParticipants     Int               @default(25)
  chatRetentionDays   Int?
  parentRoomId        String?
  parentRoom          Room?               @relation("Breakouts", fields: [parentRoomId], references: [id], onDelete: Cascade)
  breakouts           Room[]              @relation("Breakouts")
  breakoutSessionId   String?
  breakoutSession     BreakoutSession?    @relation(fields: [breakoutSessionId], references: [id], onDelete: SetNull)
  hostedBreakouts     BreakoutSession[]   @relation("BreakoutParent")
  childAssignments    BreakoutAssignment[] @relation("AssignmentChild")
  participants        RoomParticipant[]
  messages            ChatMessage[]
  recordings          Recording[]
  streams             Stream[]
  polls               Poll[]
  questions           Question[]
  whiteboardSessions  WhiteboardSession[]
  qosReports          QosReport[]
}

model BreakoutSession {
  id             String                  @id @default(cuid())
  parentRoomId   String
  parentRoom     Room                    @relation("BreakoutParent", fields: [parentRoomId], references: [id], onDelete: Cascade)
  status         BreakoutSessionStatus   @default(open)
  assignmentMode BreakoutAssignmentMode
  endsAt         DateTime?
  createdAt      DateTime                @default(now())
  childRooms     Room[]
  assignments    BreakoutAssignment[]

  @@index([parentRoomId, status])
}

model BreakoutAssignment {
  id          String          @id @default(cuid())
  sessionId   String
  userId      String
  childRoomId String
  session     BreakoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  childRoom   Room            @relation("AssignmentChild", fields: [childRoomId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([childRoomId])
}

model RoomParticipant {
  id          String      @id @default(cuid())
  roomId      String
  userId      String
  role        RoomRole
  banned      Boolean     @default(false)
  lobbyStatus LobbyStatus
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  roomId        String
  senderId      String
  body          String
  recipientId   String?
  attachmentKey String?
  createdAt     DateTime @default(now())
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User     @relation("ChatSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User?    @relation("ChatReceived", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model Recording {
  id            String              @id @default(cuid())
  roomId        String
  startedById   String
  mode          RecordingMode
  status        RecordingStatus     @default(pending_consent)
  egressIds     String[]            @default([])
  objectKey     String?
  hlsPrefix     String?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  room          Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedBy     User                @relation(fields: [startedById], references: [id])
  consents      RecordingConsent[]
  transcript    Transcript?

  @@index([roomId, createdAt])
}

model RecordingConsent {
  id          String    @id @default(cuid())
  recordingId String
  userId      String
  consentedAt DateTime  @default(now())
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordingId, userId])
}

model Stream {
  id          String           @id @default(cuid())
  roomId      String
  startedById String
  status      RecordingStatus  @default(pending_consent)
  rtmpUrls    String[]         @default([])
  hlsPrefix   String?
  egressIds   String[]         @default([])
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime         @default(now())
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedBy   User             @relation(fields: [startedById], references: [id])
  consents    StreamConsent[]

  @@index([roomId, createdAt])
}

model StreamConsent {
  id          String   @id @default(cuid())
  streamId    String
  userId      String
  consentedAt DateTime @default(now())
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyId      String    @unique
  secretEnc  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEndpoint {
  id         String             @id @default(cuid())
  userId     String
  url        String
  secretEnc  String
  events     String[]
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id          String                 @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  status      WebhookDeliveryStatus  @default(pending)
  attempts    Int                    @default(0)
  nextRetryAt DateTime               @default(now())
  lastError   String?
  createdAt   DateTime               @default(now())
  endpoint    WebhookEndpoint        @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model OrgSetting {
  key   String @id
  value Json
}

model Poll {
  id          String       @id @default(cuid())
  roomId      String
  question    String
  status      PollStatus   @default(open)
  createdById String
  createdAt   DateTime     @default(now())
  closedAt    DateTime?
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  options     PollOption[]
  votes       PollVote[]

  @@index([roomId, status])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId, optionId])
}

model Question {
  id         String           @id @default(cuid())
  roomId     String
  userId     String
  body       String
  status     QuestionStatus   @default(pending)
  isPinned   Boolean          @default(false)
  answer     String?
  upvoteCount Int             @default(0)
  createdAt  DateTime         @default(now())
  answeredAt DateTime?
  room       Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  upvotes    QuestionUpvote[]

  @@index([roomId, status, isPinned, createdAt])
}

model QuestionUpvote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

model WhiteboardSession {
  id          String                  @id @default(cuid())
  roomId      String
  status      WhiteboardSessionStatus @default(open)
  openedById  String
  snapshotKey String?
  createdAt   DateTime                @default(now())
  closedAt    DateTime?
  room        Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  openedBy    User                    @relation(fields: [openedById], references: [id])

  @@index([roomId, status])
}

model Transcript {
  id          String             @id @default(cuid())
  recordingId String             @unique
  status      TranscriptStatus   @default(pending)
  language    String?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  finishedAt  DateTime?
  recording   Recording          @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]
  summary     MeetingSummary?

  @@index([status, createdAt])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  startMs      Int
  endMs        Int
  speakerLabel String
  text         String
  sortOrder    Int
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, sortOrder])
}

model MeetingSummary {
  id           String               @id @default(cuid())
  transcriptId String               @unique
  status       MeetingSummaryStatus @default(not_configured)
  bodyMarkdown String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transcript   Transcript           @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
}

model DailyOrgMetrics {
  date               DateTime @id @db.Date
  roomsCreated       Int      @default(0)
  participantMinutes Int      @default(0)
  recordingsFinished Int      @default(0)
  uniqueUsers        Int      @default(0)
}

model QosReport {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  rttMs       Int?
  packetLoss  Float?
  jitterMs    Int?
  bitrateKbps Int?
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
